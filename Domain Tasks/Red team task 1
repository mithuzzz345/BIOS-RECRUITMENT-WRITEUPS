<?php
include("db.php");
include("auth_check.php");

$user_id = $_SESSION["user_id"];
$message = "";

$stmt = mysqli_prepare($conn, "SELECT * FROM users WHERE id = ?");
mysqli_stmt_bind_param($stmt, "i", $user_id);
mysqli_stmt_execute($stmt);
$user = mysqli_fetch_assoc(mysqli_stmt_get_result($stmt));

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    if (isset($_POST["update_info"])) {
        $username = trim($_POST["username"]);
        $email = trim($_POST["email"]);

        $stmt = mysqli_prepare($conn, "UPDATE users SET username = ?, email = ? WHERE id = ?");
        mysqli_stmt_bind_param($stmt, "ssi", $username, $email, $user_id);
        mysqli_stmt_execute($stmt);

        $user["username"] = $username;
        $user["email"] = $email;
        $message = "Profile updated";

    } elseif (isset($_POST["update_password"])) {
        $new_password = password_hash($_POST["new_password"], PASSWORD_DEFAULT);

        $stmt = mysqli_prepare($conn, "UPDATE users SET password = ? WHERE id = ?");
        mysqli_stmt_bind_param($stmt, "si", $new_password, $user_id);
        mysqli_stmt_execute($stmt);

        $message = "Password updated";

    } elseif (isset($_FILES["avatar"])) {
        $file = $_FILES["avatar"];

        if ($file["error"] == 4) {
            $message = "Please choose a file first";
        } elseif ($file["error"] != 0) {
            $message = "Upload error, code: " . $file["error"];
        } else {
            $allowed = ["jpg", "jpeg", "png", "gif"];
            $ext = strtolower(pathinfo($file["name"], PATHINFO_EXTENSION));

            // check the real image type, not just the file extension
            $check = getimagesize($file["tmp_name"]);

            if (!in_array($ext, $allowed) || $check === false) {
                $message = "Invalid file type. Only jpg, jpeg, png, gif allowed.";
            } else {
                $new_filename = "user_" . $user_id . "_" . time() . "." . $ext;
                $destination = __DIR__ . "/uploads/" . $new_filename;

                if (move_uploaded_file($file["tmp_name"], $destination)) {
                    $stmt = mysqli_prepare($conn, "UPDATE users SET avatar = ? WHERE id = ?");
                    mysqli_stmt_bind_param($stmt, "si", $new_filename, $user_id);
                    mysqli_stmt_execute($stmt);

                    $user["avatar"] = $new_filename;
                    $message = "Avatar uploaded";
                } else {
                    $message = "Upload failed. Make sure the uploads folder exists.";
                }
            }
        }
    }
}
